# Derived index — rebuilt by `jt reindex`, never committed.
# A committed SQLite binary corrupts when the cloud routine and this machine
# both write between pulls.
jobs.db
jobs.db-wal
jobs.db-shm

# LaTeX build noise
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

.venv/
__pycache__/
*.pyc
.env

# Local routine log (scripts/run-routine.sh)
.routine.log

# transient scaffold for `jt evidence add`
profile/pending-evidence.yaml

# /j writes its Discord reply here; the workflow posts and removes it
.jobloop-reply.md

# Lock shared by run-routine.sh and drain-inbox.sh
.jobloop.lock
